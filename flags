#!/system/bin/sh
# DeviceConfig flags for PE-Revived (Android 17 base v907).
# Checked against the decompiled base: of the old set, only
# enable_one_search is still read in code. The rest were removed upstream,
# so forcing them would be a no-op. Live flag names observed on an
# Android 17 device use the com.android.launcher3.* form below.

# Make changes to `DeviceConfig` flags persistent.
cmd device_config set_sync_disabled_for_tests persistent

# Main
# Unified search entry point (read in allapps + settings, default true)
cmd device_config put launcher enable_one_search true
# Responsive workspace backs the extra grid sizes
cmd device_config put launcher com.android.launcher3.enable_responsive_workspace true
